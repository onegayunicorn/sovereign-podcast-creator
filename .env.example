# ==========================================
# SOVEREIGN PODCAST CREATOR — ENVIRONMENT
# ==========================================

# ---- Core ----
NODE_ENV=development
PORT=3001
WEB_PORT=5173
LOG_LEVEL=info

# ---- Database ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/podcast_creator
REDIS_URL=redis://localhost:6379

# ---- Firebase Auth ----
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789
FIREBASE_APP_ID=1:123456789:web:abc123
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# ---- Object Storage ----
GCS_BUCKET_NAME=sovereign-podcast-assets
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
STORAGE_PROVIDER=local  # gcs | s3 | r2 | local

# ---- AI Providers ----
LLM_PROVIDER=mock  # gemini | openai | mock
GEMINI_API_KEY=
OPENAI_API_KEY=

TTS_PROVIDER=mock  # interactions | openai | elevenlabs | local | mock
INTERACTIONS_API_ENDPOINT=https://interactions.api.google.com/v1

MUSIC_PROVIDER=mock  # lyria | mock
LYRIA_MODEL=lyria-3-clip-preview

IMAGE_PROVIDER=mock  # gemini | mock

# ---- Quota & Rate Limiting ----
DAILY_GENERATION_LIMIT=3
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---- DSP Engine ----
DSP_WORKER_URL=http://localhost:5000
DSP_SAMPLE_RATE=22050
DSP_FFT_SIZE=2048
DSP_HOP_SIZE=512

# ---- Frontend ----
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Feature Flags ----
ENABLE_MOCK_PROVIDERS=true
ENABLE_DSP_ENGINE=true
ENABLE_SHARING=true
